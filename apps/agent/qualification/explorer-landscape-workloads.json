{
  "schema": "rey.explorer-landscape-workloads.v3",
  "suite_id": "rey.explorer.landscape-fidelity@4",
  "authority": "source-controlled browser qualification requirements for separately admitted named fixtures; not terrain evidence, permission to synthesize inputs, or proof authority",
  "required_backends": ["reference", "webgl2", "webgpu"],
  "target_viewports": ["1920x1080", "3840x2160"],
  "fixture_matrix": [
    {
      "id": "one-patch-holes",
      "proof": "apps/agent/src/explore/projection/regional-scene-topology.test.ts",
      "assertion": "renders a qualified regional grid while retaining an explicit no-data hole"
    },
    {
      "id": "touching-patches",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "compiles qualified adjacent patches into one validity-safe field"
    },
    {
      "id": "partial-overlap",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "retains conflicts and resolves partial overlap independently from input order"
    },
    {
      "id": "nested-resolutions",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "uses nominal metric spacing before stable identity"
    },
    {
      "id": "rejected-datum",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "rejects a patch whose declared horizontal or vertical datum changed"
    },
    {
      "id": "unsupported-gap",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "retains unsupported space between disjoint patches as invalid"
    },
    {
      "id": "admitted-overview-gap-fill",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "fills only otherwise unsupported space from an admitted overview DEM"
    },
    {
      "id": "steep-relief",
      "proof": "packages/explorer/src/landscape-relief.test.ts",
      "assertion": "separates steep ridges from low relief without black MDOW shadows"
    },
    {
      "id": "low-relief",
      "proof": "packages/explorer/src/landscape-relief.test.ts",
      "assertion": "separates steep ridges from low relief without black MDOW shadows"
    },
    {
      "id": "water-coastline",
      "proof": "apps/agent/src/explore/engine/terrain-passes.test.ts",
      "assertion": "clips a draped water surface to its exact admitted polygon edge"
    },
    {
      "id": "dense-vectors",
      "proof": "apps/agent/src/explore/engine/terrain-passes.test.ts",
      "assertion": "retains a deterministic dense-vector fixture under one terrain transform"
    },
    {
      "id": "stale-input",
      "proof": "apps/agent/src/explore/engine/scene.test.ts",
      "assertion": "retains the last-good immutable scene when a later projection fails"
    },
    {
      "id": "backend-loss",
      "proof": "packages/explorer/src/three-webgpu.test.ts",
      "assertion": "reports WebGPU device loss as a visible reference fallback"
    }
  ],
  "invariant_matrix": [
    {
      "id": "no-validity-gain",
      "proof": "apps/agent/src/explore/terrain/height-pyramid.test.ts",
      "assertion": "downsamples validity conservatively without gaining support"
    },
    {
      "id": "whole-field-tile-equivalence",
      "proof": "apps/agent/src/explore/terrain/relief-pyramid.test.ts",
      "assertion": "derives every level from haloed tiles with exact borders and partitions"
    },
    {
      "id": "border-digest-agreement",
      "proof": "apps/agent/src/explore/terrain/relief-pyramid.test.ts",
      "assertion": "derives every level from haloed tiles with exact borders and partitions"
    },
    {
      "id": "deterministic-overlap",
      "proof": "apps/agent/src/explore/terrain/regional-mosaic.test.ts",
      "assertion": "retains conflicts and resolves partial overlap independently from input order"
    },
    {
      "id": "zero-unsupported-triangles",
      "proof": "apps/agent/src/explore/terrain/tiles.test.ts",
      "assertion": "retains stable parentage and identical shared validity borders"
    },
    {
      "id": "zero-relief-seams",
      "proof": "apps/agent/src/explore/terrain/worker.test.ts",
      "assertion": "projects, resamples, and prepares a named tile workload"
    },
    {
      "id": "bounded-residency",
      "proof": "apps/agent/src/explore/terrain/residency.test.ts",
      "assertion": "rejects an active set larger than either retained budget"
    },
    {
      "id": "stable-picking",
      "proof": "apps/agent/src/explore/engine/picking.test.ts",
      "assertion": "binds every chart copy to one immutable semantic identity"
    },
    {
      "id": "exact-revision-lineage",
      "proof": "apps/agent/scripts/explorer-landscape-qualification.test.mjs",
      "assertion": "requires exact lineage, bounded resources, and zero no-data leakage"
    }
  ],
  "perceptual_criteria": [
    "composition",
    "multiscale_mdow",
    "hillshade_continuity",
    "sky_view_valley_depth",
    "dual_tone_chromatic_lighting",
    "hypsometric_land_cover",
    "terrain_bound_hydrology",
    "contour_hierarchy",
    "vector_hierarchy",
    "no_crosshatch_grid",
    "no_flat_scalar_mud",
    "no_plastic_smoothing"
  ],
  "workloads": [
    {
      "id": "steep-relief",
      "purpose": "retain legible high-gradient relief and bounded screen-space error",
      "requirements": {
        "require_landscape_mosaic": true,
        "minimum_elevation_span": 75,
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0,
        "required_render_passes": [
          "height_normals_hillshade",
          "ambient_valley_occlusion"
        ]
      }
    },
    {
      "id": "low-relief",
      "purpose": "retain subtle material and hillshade response without exaggerating source height",
      "requirements": {
        "require_landscape_mosaic": true,
        "maximum_elevation_span": 5,
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0,
        "required_render_passes": ["base_terrain", "height_normals_hillshade"]
      }
    },
    {
      "id": "coastline-water",
      "purpose": "retain water and admitted boundary geometry against explicit land/water support",
      "requirements": {
        "require_landscape_mosaic": true,
        "minimum_source_no_data_vertices": 1,
        "minimum_render_pass_areas": 1,
        "minimum_render_pass_lines": 2,
        "required_render_passes": ["water_weather_boundary"],
        "required_render_pass_kinds": [
          "admitted_boundary",
          "river",
          "water_area"
        ],
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0
      }
    },
    {
      "id": "dense-vectors",
      "purpose": "retain dense admitted and derived linework within the draw and interaction budgets",
      "requirements": {
        "require_landscape_mosaic": true,
        "minimum_render_pass_lines": 32,
        "minimum_label_candidates": 16,
        "required_render_passes": [
          "contours",
          "water_weather_boundary",
          "features_labels_selection"
        ],
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0
      }
    },
    {
      "id": "explicit-holes",
      "purpose": "retain visible no-data holes through tiling, meshing, passes, and both accelerated backends",
      "requirements": {
        "require_landscape_mosaic": true,
        "minimum_source_no_data_vertices": 1,
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0,
        "required_render_passes": ["validity_background", "base_terrain"]
      }
    },
    {
      "id": "stale-data",
      "purpose": "retain stale-source disclosure without treating it as fresh terrain",
      "requirements": {
        "require_landscape_mosaic": true,
        "required_scene_omission_terms": ["stale"],
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0
      }
    },
    {
      "id": "backend-loss",
      "purpose": "retain the same semantic Landscape and visible reference fallback after real backend loss",
      "requirements": {
        "require_landscape_mosaic": true,
        "require_backend_loss": true,
        "maximum_screen_error_pixels": 1.5,
        "maximum_relief_partition_mismatches": 0,
        "maximum_tile_seam_mismatches": 0,
        "maximum_no_data_leak_triangles": 0,
        "required_render_passes": [
          "validity_background",
          "base_terrain",
          "evidence_accessibility"
        ]
      }
    }
  ]
}
