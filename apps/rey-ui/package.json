{
  "name": "@rey/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "format": "prettier --write index.html scripts src vite.config.ts vitest.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "format:check": "prettier --check index.html scripts src vite.config.ts vitest.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "qualify:explorer": "node scripts/qualify-explorer.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hifi/core": "github:rupurt/hifi#058c6504fc10740360717e97e687fd77bef6a5c5&path:packages/core",
    "@hifi/kinetic": "github:rupurt/hifi#058c6504fc10740360717e97e687fd77bef6a5c5&path:packages/kinetic",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-router": "^1.170.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
