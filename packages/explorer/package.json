{
  "name": "@rey/explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./globe-samples": "./src/globe-samples.ts",
    "./three-fiber-runtime": "./src/three-fiber-runtime.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src package.json tsconfig.json vitest.config.ts",
    "format:check": "prettier --check src package.json tsconfig.json vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "three": "0.185.1"
  },
  "peerDependencies": {
    "react": ">=19 <20"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@types/react": "^19.2.18",
    "@types/three": "0.185.4",
    "prettier": "^3.8.2",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
